# Either a full URL...
# DATABASE_URL=postgres://user:password@host:5432/olympia
# ...or the standard libpq variables (unset ones default to localhost:5432).
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=postgres
PGDATABASE=olympia
# PGSSLMODE=require

# Max cl100k tokens per chunk (default 512). Changing it re-chunks stored files on their next upload.
# CHUNK_MAX_TOKENS=512
